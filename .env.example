# Copy this file to `.env` (which is gitignored) and fill in real values.

# ── Discord bot ────────────────────────────────────────────────────────────
TOKEN_TEST=
PREFIX=!
OPENAI_API_KEY=

# ── Verifier bot (production-server Nederlander role checker) ───────────────
# Separate Discord application that sits read-only in the production server.
TOKEN_VERIFIER=
# Shared secret between verifier-bot and the war-guild bot.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
VERIFIER_SECRET=
# Production server ID and Nederlander role ID (read by verifier-bot at startup).
VERIFIER_GUILD_ID=1401530718223335496
VERIFIER_ROLE_ID=1456281070722093058
# Port the verifier HTTP server listens on.
VERIFIER_PORT=8765

# ── Website admin / Discord OAuth ──────────────────────────────────────────
# Discord application — used by /admin to authenticate operators.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://example.com/auth/discord/callback

# Guild + role that grants /admin access. A logged-in Discord user with
# any of these roles on this guild becomes an admin.
ADMIN_GUILD_ID=
ADMIN_ROLE_IDS=
# Optional: comma-separated raw user IDs that always have admin.
ADMIN_USER_IDS=

# Cookie-signing secret. Keep stable across restarts so admin sessions
# survive container restarts. Generate with:
#   python -c "import secrets;print(secrets.token_hex(32))"
ADMIN_SESSION_SECRET=

# ── Full-fetcher tuning (optional) ─────────────────────────────────────────
FULL_FETCH_INTERVAL_MINUTES=60
FULL_FETCH_RUN_AT_STARTUP=1
FULL_FETCH_COUNTRY_LIMIT=0
